<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>2.0.0-SNAPSHOT</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-ftp</artifactId>
	<version>2.0.0-SNAPSHOT</version>
	<name>Parley FTP</name>
	<inceptionYear>2004</inceptionYear>
	<description>An implementation of the FTP protocol, client and server (FTP, FTPS explicit and implicit, RFC 2228 and RFC 2428), built on parley-net with files served from any parley-files FileSource. Formerly us.bringardner:bjl_net_ftp.</description>

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.ftp</parley.moduleName>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<junit.version>5.11.4</junit.version>
		<spotbugs.version>4.8.6.6</spotbugs.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.2</version>
			</plugin>

			<!-- Attach a -sources jar (was only in pluginManagement, so it never ran) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Static analysis: "mvn verify" fails on new findings.
			     Accepted findings are listed in spotbugs-exclude.xml -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>${spotbugs.version}</version>
				<configuration>
					<effort>Max</effort>
					<threshold>Low</threshold>
					<excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
				</configuration>
				<executions>
					<execution>
						<id>spotbugs-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<distributionManagement>
		<repository>
			<id>github</id>
			<name>parley-project</name>
			<url>https://maven.pkg.github.com/parley-project/parley-ftp</url>
		</repository>
	</distributionManagement>

	<dependencies>
		<!-- Used directly (IoUtils), so named here too. Was bjl_io. -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-io</artifactId>
			<version>2.0.0-SNAPSHOT</version>
		</dependency>
		<!-- Used directly, and named here so this version wins over any older one brought in
		     transitively (parley-net needs BaseThread.setVirtual, BJL-51). Was bjl_core. -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-core</artifactId>
			<version>2.0.0-SNAPSHOT</version>
		</dependency>
		<!-- Was bjl_file_system -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>2.0.0-SNAPSHOT</version>
		</dependency>
		<!-- Was bjl_net_framework -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-net</artifactId>
			<version>2.0.0-SNAPSHOT</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
