# The settings parley-ftp reads, for the servers' start-up check
# (format: parley-net's KnownSettings). Add a name here when code here starts reading it.

# FtpServer on its own (parley.ftp, parley.ftps); a server made with another prefix declares its
# names in its own module's list (the mail suite's ftp and ftps: parley-mail's)
prefix parley.ftp
prefix parley.ftps

parley.ftp.configFile

# FtpServer on its own: one value per JVM
parley.ftp.root
parley.ftp.fileSource
parley.ftp.virtualHosts
parley.ftp.sharedStore
parley.ftp.serverId

# each FTP server's, under its prefix
parley.{ftp,ftps}.allowForeignDataAddress
parley.{ftp,ftps}.allowedLinkTargets
parley.{ftp,ftps}.bufferSize
parley.{ftp,ftps}.connectTimeout
parley.{ftp,ftps}.dataTimeout
parley.{ftp,ftps}.externalAddress
parley.{ftp,ftps}.linger
parley.{ftp,ftps}.passivePort
parley.{ftp,ftps}.passiveMinPort
parley.{ftp,ftps}.passiveMaxPort
parley.{ftp,ftps}.requireTls
parley.{ftp,ftps}.serverId
parley.{ftp,ftps}.storeAtOffset
parley.{ftp,ftps}.symlinkPolicy
parley.{ftp,ftps}.uploadMode
